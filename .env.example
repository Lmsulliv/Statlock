# Copy to .env and fill in. Compose reads .env automatically.
#   cp .env.example .env
#
# .env is gitignored -- NEVER commit real secrets. This file (.env.example)
# carries no secrets and is safe to track.
#
# Dev (docker-compose.yml) only needs the write-auth vars and optionally
# STEAM_API_KEY. Production (docker-compose.prod.yml) additionally needs DOMAIN
# and the four LITESTREAM_* vars. See docs/deploy-production.md.

# ── Public origin / TLS ───────────────────────────────────────────────────────

# The hostname Caddy serves and requests a certificate for (production only).
# Use a real DNS name pointing at this server for a Let's Encrypt cert. Use
# "localhost" to test the prod stack locally with Caddy's self-signed CA.
DOMAIN=stats.example.com

# ── Write authentication (reads are always open) ──────────────────────────────
#
# Writes FAIL CLOSED: with NEITHER of the next two set, every write returns 403
# while reads keep working -- so a deploy that forgets to configure auth can't
# silently expose a shared admin panel. Set exactly ONE of them.

# Public deploy: the app's public origin. Setting it turns Steam login ON --
# writes require a logged-in session and are CSRF-protected. Steam redirects back
# to <base>/api/auth/callback, so this must be the real external URL. Use https://
# in production so the login cookies are Secure. Usually the same as DOMAIN:
#   DEADLOCK_BASE_URL=https://stats.example.com
DEADLOCK_BASE_URL=

# DEV / private single-user ONLY. Set to 1 to open writes with NO login (every
# write runs as one local user). Ignored when DEADLOCK_BASE_URL is set.
#   WARNING: never set this on a public, internet-reachable deploy -- it removes
#   all write protection. For a public site use DEADLOCK_BASE_URL instead and
#   leave this unset. It exists for local dev and truly-private single-user boxes.
# DEADLOCK_OPEN_WRITES=1

# ── Worker enrichment (optional) ──────────────────────────────────────────────

# Steam Web API key for persona (display-name) enrichment during worker
# maintenance. Clean no-op when unset -- accounts just fall back to bare ids.
# NOT needed for Steam login (OpenID doesn't use it).
STEAM_API_KEY=

# deadlock-api key. The app works fully UNAUTHENTICATED (leave blank); set this
# only if the deadlock-api maintainers grant you a key. When set it is sent on
# every deadlock-api request (X-API-Key header). No code change needed.
DEADLOCK_API_KEY=

# deadlock-api request ceiling, in requests per second. Default (unset/blank) is
# 0.2 == 1 request every 5 seconds (hard rule 3). deadlock-api is community-run
# on donations, so DO NOT raise this unless the maintainers have explicitly
# blessed a higher rate for your deployment. An invalid value (non-numeric or
# <= 0) makes the worker fail loudly at startup rather than silently defaulting.
# DEADLOCK_REQUESTS_PER_SECOND=0.2

# The account id the logged-out landing highlights as a live demo. When set, a
# prominent "View a live demo profile" button appears for signed-out visitors,
# linking to /player/<id> (a public, read-only profile). Leave blank to hide it.
# Also personalizes the link-preview tags for /player/<id> pages.
DEMO_ACCOUNT_ID=

# ── Litestream continuous backup (production only) ────────────────────────────
#
# S3-compatible object storage credentials + location. Litestream streams the
# SQLite WAL here continuously (see deploy/litestream.yml). Two common providers,
# pick one and use its endpoint format:
#
#   Backblaze B2:      https://s3.<region>.backblazeb2.com   (e.g. us-west-004)
#   Cloudflare R2:     https://<account-id>.r2.cloudflarestorage.com
#
# Create a bucket and an application key scoped to it, then fill these in.
LITESTREAM_BUCKET=deadlock-tracker-backups
LITESTREAM_ENDPOINT=https://s3.us-west-004.backblazeb2.com
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
